{
  "name": "@openzeppelin/tronbox-upgrades",
  "version": "0.1.0",
  "description": "OpenZeppelin Upgrades plugin for TronBox: deploy and upgrade proxies on TRON with upgrade-safety validations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenZeppelin/tron-upgrades.git",
    "directory": "packages/tronbox-upgrades"
  },
  "homepage": "https://github.com/OpenZeppelin/tron-upgrades/tree/main/packages/tronbox-upgrades#readme",
  "bugs": {
    "url": "https://github.com/OpenZeppelin/tron-upgrades/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "contracts",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "test": "npm run test:types && vitest run",
    "test:e2e": "node e2e/run.mjs",
    "test:types": "tsc -p tsconfig.test.json",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@openzeppelin/tron-contracts": "^5.6.0-rc.1",
    "@openzeppelin/upgrades-core": "^1.46.0"
  },
  "peerDependencies": {
    "ethers": "^6.13.0",
    "tronbox": ">=4.8.0",
    "tronweb": ">=6.0.0"
  },
  "devDependencies": {
    "ethers": "^6.17.0",
    "tronbox-4.8.0": "npm:tronbox@4.8.0",
    "tronbox-4.9.0": "npm:tronbox@4.9.0",
    "tronweb": "^6.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "tron",
    "tvm",
    "tronbox",
    "upgrades",
    "proxy",
    "smart-contracts"
  ]
}
